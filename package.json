{
  "name": "agent-secret-capsule-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config site/vite.config.ts",
    "build:site": "vite build --config site/vite.config.ts",
    "build:cli": "cargo build --release --locked",
    "build": "npm run build:cli && npm run build:site",
    "test:rust": "cargo test --workspace --locked",
    "test:site": "vitest run --config site/vitest.config.ts",
    "test:e2e": "npm run build:site && playwright test",
    "test:claim": "npm run build:site && playwright test",
    "test": "npm run test:rust && npm run test:site && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
